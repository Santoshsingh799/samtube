# Get a free key from Google Cloud Console:
#   1. Create/select a project
#   2. Enable "YouTube Data API v3"
#   3. Create an API key and paste it below
#
# The app works WITHOUT a key too (key-free public search mode).
# Add a key for higher reliability and official quota.
# YouTube Data API v3 key (optional — app works without it in key-free mode)
YOUTUBE_API_KEY=your_key_here

# PostgreSQL connection — REQUIRED for Login/Signup, Custom Sections, persistence.
# Local dev (after creating the samtube database — see README):
#   DATABASE_URL=postgresql://postgres:your_password@localhost:5432/samtube
# Production (Render / Supabase): paste the provided connection string (sslmode=require).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/samtube

PORT=5000

# Secret for signing — reserved for future use (sessions are opaque DB tokens today)
SESSION_SECRET=change_me_to_a_long_random_string

# Comma-separated list of allowed client origins (optional)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Frontend (Vite) only — Render backend ka public URL. Local dev me empty rakho
# (vite proxy automatic chalta hai). Vercel me ye Render URL set karo.
VITE_API_URL=
